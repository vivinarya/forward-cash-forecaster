# Cashpilot runs fully offline with no keys at all. Everything here is OPTIONAL.
# Copy to `.env` and `set -a; . ./.env; set +a` if you want the LLM judgement layer.

# ---- Optional: OpenAI-compatible chat endpoint used ONLY for two jobs ----
# 1. narrating the cash brief   2. adjudicating ambiguous reconciliation exceptions
# If unset, Cashpilot falls back to the deterministic heuristic judge + templates
# and prints llm_used=false in artifacts/run_manifest.json. No silent surprises.
CASHPILOT_LLM_ENABLED=0
CASHPILOT_LLM_BASE_URL=https://api.openai.com/v1
CASHPILOT_LLM_MODEL=gpt-4o-mini
CASHPILOT_LLM_API_KEY=sk-you…here
CASHPILOT_LLM_MAX_CALLS=200
CASHPILOT_LLM_TIMEOUT_S=20

# ---- Razorpay API ----
# Nothing in this repo calls the Razorpay API: live fetching is deliberately not implemented, and
# the demo runs entirely from CSV exports in data/. These names are here to make that boundary
# explicit (and to show where a real integration would read them) - leave them empty.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
